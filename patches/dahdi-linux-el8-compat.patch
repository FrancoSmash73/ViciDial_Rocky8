diff --git a/include/dahdi/kernel.h b/include/dahdi/kernel.h
index 8f83283..7da7941 100644
--- a/include/dahdi/kernel.h
+++ b/include/dahdi/kernel.h
@@ -1564,6 +1564,27 @@ static inline void *PDE_DATA(const struct inode *inode)
 #define TIMER_DATA_TYPE struct timer_list *
 #endif
 
+/* Linux 6.16 renamed from_timer() to timer_container_of() (RHEL 10's 6.12
+ * kernel carries the backport). Older kernels, e.g. RHEL/Rocky 8's 4.18,
+ * only have from_timer(), so map the new name onto it there. */
+#include <linux/timer.h>
+#ifndef timer_container_of
+#define timer_container_of(var, callback_timer, timer_fieldname) \
+	from_timer(var, callback_timer, timer_fieldname)
+#endif
+
+/* RHEL/Rocky 8.10's 4.18 kernel also backports the Linux 6.1 NAPI change:
+ * netif_napi_add() is a 3-argument macro there and the 4-argument form is
+ * netif_napi_add_weight(). DAHDI passes a weight (wctc4xxp, voicebus), so
+ * point it at the _weight variant, as kernel.h already does for 6.1+ and
+ * RHEL 9.1+. The version check is only "older than RHEL 9's 5.14"; the
+ * real test is whether the kernel headers made netif_napi_add a macro. */
+#include <linux/netdevice.h>
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 14, 0) && defined(netif_napi_add)
+#undef netif_napi_add
+#define netif_napi_add netif_napi_add_weight
+#endif
+
 #ifndef dahdi_ktime_equal
 static inline int dahdi_ktime_equal(const ktime_t cmp1, const ktime_t cmp2)
 {
